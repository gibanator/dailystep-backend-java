# Database (local Spring Boot)
DB_URL=jdbc:postgresql://localhost:5432/db_name
DB_USER=uname
DB_PASSWORD=password

# Docker Postgres
POSTGRES_DB=db_name
POSTGRES_USER=uname
POSTGRES_PASSWORD=password

# GigaChat (Sber) — https://developers.sber.ru/portal/products/gigachat-api
# Authorization key (base64 от client_id:client_secret) из личного кабинета GigaChat API
GIGACHAT_API_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# dev: true пропускает проверку TLS-сертификата. В проде — false + сертификаты Минцифры.
GIGACHAT_UNSAFE_SSL=true
GIGACHAT_MODEL=GigaChat

# Claude (Anthropic) — https://console.anthropic.com
# Пусто = провайдер CLAUDE не поднимается и не появляется в GET /api/v1/ai/models.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# CLAUDE_BASE_URL=            # опционально: свой gateway/прокси

# Qwen (Alibaba DashScope, OpenAI-совместимый) — https://dashscope.aliyun.com
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode

# DeepSeek (OpenAI-совместимый) — https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com